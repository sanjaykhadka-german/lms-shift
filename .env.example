# ─── Database: Supabase Postgres ───
# Runtime connection — Supabase TRANSACTION pooler (port 6543). Drizzle/postgres-js
# uses this; prepare:false is set in client.ts because the transaction pooler does
# not support prepared statements.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations connection — Supabase SESSION pooler / direct (port 5432). drizzle-kit
# and src/migrate.ts use this for stable DDL sessions.
DIRECT_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Supabase Auth ───
# Project URL and anon key (Project Settings → API). NEXT_PUBLIC_* are sent to the
# browser. The service-role key is server-only (admin auth ops) — never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Resend) ───
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=Tracey

# ─── LMS config ───
# Quiz pass threshold (percent). lms-web reads LMS_PASS_THRESHOLD; default 80.
LMS_PASS_THRESHOLD=80
# Comma-separated emails granted the /platform super-admin surface.
PLATFORM_ADMIN_EMAILS=
# Secret used to HMAC-sign public certificate-verification tokens (/verify/...).
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset; set a dedicated value in prod.
CERTIFICATE_SECRET=

# ─── AI providers ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Stripe (https://dashboard.stripe.com — developers / API keys) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# For each plan create one product with TWO prices (monthly + yearly), each with
# metadata.plan = starter | pro (the webhook reads price.metadata.plan).
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# ─── App origins (no trailing slash) ───
# In dev these default to localhost ports. In prod set them to your real origins,
# e.g. https://lms.tracey.app / https://shifts.tracey.app.
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_LMS_URL=http://localhost:4000
NEXT_PUBLIC_SHIFTCRAFT_URL=http://localhost:4100
